# Force HTTPS and redirect all HTTP traffic to HTTPS
# =========================
# REDIRECT creatoke.fr → creatoke.com
# =========================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect creatoke.fr and www.creatoke.fr to creatoke.com
  RewriteCond %{HTTP_HOST} ^(www\.)?creatoke\.fr$ [NC]
  RewriteRule ^(.*)$ https://creatoke.com/$1 [R=301,L]
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect all HTTP requests to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www (Optional)
  # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Handle Angular Routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# Set Cache-Control headers to cache static files
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|js|css|json|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|ico)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  # Fichiers dont le nom ne change pas d'une version à l'autre : le navigateur
  # revérifie à chaque visite (sinon une mise à jour du site reste invisible
  # pendant un an pour qui est déjà venu).
  <FilesMatch "^(index\.html|theme-light\.css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ✅ Allow Cross-Origin Requests (CORS) for JavaScript Downloads
<IfModule mod_headers.c>
    Header Set Access-Control-Allow-Origin "*"
    Header Set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header Set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>

# ✅ Force File Downloads Instead of Opening in Browser
<FilesMatch "\.(mp3|mp4|pdf|zip|rar|docx?|xlsx?|pptx?)$">
    Header set Content-Disposition "attachment"
</FilesMatch>